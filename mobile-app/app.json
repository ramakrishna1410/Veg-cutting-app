{
  "expo": {
    "name": "Veg Cutting App",
    "slug": "veg-cutting-app",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#2F6B3C"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vegcuttingapp.customer",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "We use your location to check if you're within our 5 km Keelkattalai delivery area and to prefill your delivery address."
      }
    },
    "android": {
      "package": "com.vegcuttingapp.customer",
      "permissions": ["ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2F6B3C"
      },
      "config": {
        "googleMaps": {
          "apiKey": "REPLACE_WITH_YOUR_ANDROID_MAPS_API_KEY"
        }
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "We use your location to check if you're within our 5 km Keelkattalai delivery area."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "e67267e3-ce24-43ab-9f20-5ccce286b7d4"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/e67267e3-ce24-43ab-9f20-5ccce286b7d4"
    }
  }
}
