rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Category and menu-item photos — public read (customers browse them
    // unauthenticated on first load), admin-only write.
    match /images/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
  }
}
